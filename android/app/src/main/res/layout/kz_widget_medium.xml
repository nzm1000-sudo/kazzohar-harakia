<?xml version="1.0" encoding="utf-8"?>
<!-- The medium widget: the date, weekday and parasha, a gold rule, the next three zmanim in sequence (candle lighting
     and havdalah among them) sunk in one well, the tzaddik of the day; the ring on its clay plate on the other side. RTL. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/kz_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/kz_widget_bg"
    android:clipToOutline="true"
    android:layoutDirection="rtl"
    android:padding="16dp">

    <LinearLayout
        android:id="@+id/kz_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/kz_date"
                android:layout_width="match_parent"
                android:gravity="center"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="serif"
                android:maxLines="1"
                android:textColor="@color/kz_widget_ink"
                android:textSize="18sp"
                 />

            <TextView
                android:id="@+id/kz_weekday"
                android:layout_width="match_parent"
                android:gravity="center"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/kz_widget_muted"
                android:textSize="15sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="4dp"
                android:gravity="center_vertical"
                android:importantForAccessibility="no"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:scaleType="fitXY"
                    android:src="@drawable/kz_widget_line_end" />

                <ImageView
                    android:layout_width="7dp"
                    android:layout_height="7dp"
                    android:layout_marginStart="5dp"
                    android:layout_marginEnd="5dp"
                    android:src="@drawable/kz_widget_diamond" />

                <ImageView
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:scaleType="fitXY"
                    android:src="@drawable/kz_widget_line" />
            </LinearLayout>

            <!-- The next three zmanim in sequence (Shabbat's candle lighting and havdalah among them): three equal
                 columns (equal weight, 1dp each side), sunk in one well, each label centred over its time. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/kz_widget_well"
                android:orientation="horizontal"
                android:paddingTop="4dp"
                android:paddingBottom="5dp"
                android:paddingStart="3dp"
                android:paddingEnd="2dp">

                <LinearLayout
                    android:id="@+id/kz_up_box_0"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingStart="1dp"
                    android:paddingEnd="1dp">

                    <TextView
                        android:id="@+id/kz_up_name_0"
                        android:layout_width="match_parent"
                        android:gravity="center"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/kz_widget_muted"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/kz_up_time_0"
                        android:layout_width="match_parent"
                        android:gravity="center"
                        android:layout_height="wrap_content"
                        android:fontFeatureSettings="tnum"
                        android:maxLines="1"
                        android:textColor="@color/kz_widget_ink"
                        android:textSize="21sp"
                        android:fontFamily="sans-serif-medium" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/kz_up_box_1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingStart="1dp"
                    android:paddingEnd="1dp">

                    <TextView
                        android:id="@+id/kz_up_name_1"
                        android:layout_width="match_parent"
                        android:gravity="center"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/kz_widget_muted"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/kz_up_time_1"
                        android:layout_width="match_parent"
                        android:gravity="center"
                        android:layout_height="wrap_content"
                        android:fontFeatureSettings="tnum"
                        android:maxLines="1"
                        android:textColor="@color/kz_widget_ink"
                        android:textSize="21sp"
                        android:fontFamily="sans-serif-medium" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/kz_up_box_2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingStart="1dp"
                    android:paddingEnd="1dp">

                    <TextView
                        android:id="@+id/kz_up_name_2"
                        android:layout_width="match_parent"
                        android:gravity="center"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/kz_widget_muted"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/kz_up_time_2"
                        android:layout_width="match_parent"
                        android:gravity="center"
                        android:layout_height="wrap_content"
                        android:fontFeatureSettings="tnum"
                        android:maxLines="1"
                        android:textColor="@color/kz_widget_ink"
                        android:textSize="21sp"
                        android:fontFamily="sans-serif-medium" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/kz_tzaddik"
                android:layout_width="match_parent"
                android:gravity="center"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/kz_widget_copper"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/kz_ring_box"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/kz_ring"
                android:layout_width="64dp"
                android:layout_height="64dp" />

            <TextView
                android:id="@+id/kz_goal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:textColor="@color/kz_widget_muted"
                android:textSize="15sp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/kz_message"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:text="@string/kz_widget_open"
        android:textColor="@color/kz_widget_muted"
        android:textSize="15sp"
        android:visibility="gone" />
</FrameLayout>
