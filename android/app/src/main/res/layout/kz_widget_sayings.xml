<?xml version="1.0" encoding="utf-8"?>
<!-- דברי חכמים (4 × 2): a saying every three hours, with its source. RTL; the app's Clay (values-night: graphite). Drawn by KZMoreWidgets. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/kz_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/kz_widget_bg"
    android:clipToOutline="true" android:layoutDirection="rtl" android:padding="16dp">

  <LinearLayout android:id="@+id/kz_content" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_horizontal" android:orientation="vertical">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
  <ImageView android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" android:scaleType="fitXY" android:src="@drawable/kz_widget_line_end" android:importantForAccessibility="no" />
  <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end" android:textColor="@color/kz_widget_copper" android:textSize="13sp" android:fontFamily="serif" android:text="דברי חכמים" android:layout_marginStart="7dp" android:layout_marginEnd="7dp" android:accessibilityHeading="true" />
  <ImageView android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" android:scaleType="fitXY" android:src="@drawable/kz_widget_line" android:importantForAccessibility="no" />
</LinearLayout>
    <TextView android:id="@+id/kz_saying_text" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:ellipsize="end" android:fontFamily="serif" android:gravity="center" android:lineSpacingExtra="2dp" android:maxLines="4" android:textColor="@color/kz_widget_ink" android:textSize="17sp" />
    <TextView android:id="@+id/kz_saying_source" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end" android:textColor="@color/kz_widget_copper" android:textSize="12sp" />
  </LinearLayout>
    <TextView android:id="@+id/kz_message" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:text="@string/kz_widget_open" android:textColor="@color/kz_widget_muted" android:textSize="15sp" android:visibility="gone" />
</FrameLayout>
