<?xml version="1.0" encoding="utf-8"?>
<!-- רביעיית תפילות (4 × 2): שחרית · מנחה · ערבית · ברכת המזון, each its own door into the Siddur. RTL; the app's cream and gold (values-night: a warm ink). Drawn by KZMoreWidgets. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/kz_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/kz_widget_bg" android:layoutDirection="rtl" android:padding="16dp">

  <LinearLayout android:id="@+id/kz_content" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
  <ImageView android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" android:scaleType="fitXY" android:src="@drawable/kz_widget_line_end" android:importantForAccessibility="no" />
  <TextView android:id="@+id/kz_q_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end" android:textColor="@color/kz_widget_gold" android:textSize="13sp" android:textStyle="bold" android:fontFamily="serif" android:layout_marginStart="7dp" android:layout_marginEnd="7dp" android:accessibilityHeading="true" />
  <ImageView android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" android:scaleType="fitXY" android:src="@drawable/kz_widget_line" android:importantForAccessibility="no" />
</LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="9dp" android:orientation="horizontal">
      <LinearLayout android:id="@+id/kz_q0" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"  android:background="@drawable/kz_widget_tile" android:gravity="center" android:orientation="vertical">
        <ImageView android:layout_width="7dp" android:layout_height="7dp" android:layout_marginBottom="5dp" android:src="@drawable/kz_widget_diamond" android:importantForAccessibility="no" />
        <TextView android:id="@+id/kz_q0_name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end" android:textColor="@color/kz_widget_ink" android:textSize="15sp" android:textStyle="bold" />
        <TextView android:id="@+id/kz_q0_hint" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end" android:textColor="@color/kz_widget_muted" android:textSize="12sp" android:fontFeatureSettings="tnum" android:layout_marginTop="2dp" />
      </LinearLayout>
      <LinearLayout android:id="@+id/kz_q1" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="8dp" android:background="@drawable/kz_widget_tile" android:gravity="center" android:orientation="vertical">
        <ImageView android:layout_width="7dp" android:layout_height="7dp" android:layout_marginBottom="5dp" android:src="@drawable/kz_widget_diamond" android:importantForAccessibility="no" />
        <TextView android:id="@+id/kz_q1_name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end" android:textColor="@color/kz_widget_ink" android:textSize="15sp" android:textStyle="bold" />
        <TextView android:id="@+id/kz_q1_hint" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end" android:textColor="@color/kz_widget_muted" android:textSize="12sp" android:fontFeatureSettings="tnum" android:layout_marginTop="2dp" />
      </LinearLayout>
      <LinearLayout android:id="@+id/kz_q2" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="8dp" android:background="@drawable/kz_widget_tile" android:gravity="center" android:orientation="vertical">
        <ImageView android:layout_width="7dp" android:layout_height="7dp" android:layout_marginBottom="5dp" android:src="@drawable/kz_widget_diamond" android:importantForAccessibility="no" />
        <TextView android:id="@+id/kz_q2_name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end" android:textColor="@color/kz_widget_ink" android:textSize="15sp" android:textStyle="bold" />
        <TextView android:id="@+id/kz_q2_hint" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end" android:textColor="@color/kz_widget_muted" android:textSize="12sp" android:fontFeatureSettings="tnum" android:layout_marginTop="2dp" />
      </LinearLayout>
      <LinearLayout android:id="@+id/kz_q3" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="8dp" android:background="@drawable/kz_widget_tile" android:gravity="center" android:orientation="vertical">
        <ImageView android:layout_width="7dp" android:layout_height="7dp" android:layout_marginBottom="5dp" android:src="@drawable/kz_widget_diamond" android:importantForAccessibility="no" />
        <TextView android:id="@+id/kz_q3_name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end" android:textColor="@color/kz_widget_ink" android:textSize="15sp" android:textStyle="bold" />
        <TextView android:id="@+id/kz_q3_hint" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end" android:textColor="@color/kz_widget_muted" android:textSize="12sp" android:fontFeatureSettings="tnum" android:layout_marginTop="2dp" />
      </LinearLayout>
    </LinearLayout>
  </LinearLayout>
</FrameLayout>
