<?xml version="1.0" encoding="utf-8"?>
<!-- A well: secondary information sunk into the card — shaded toward the light, a bright lip away from it. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <gradient android:angle="315" android:startColor="@color/kz_widget_sink" android:endColor="@color/kz_widget_sink_hi" />
        </shape>
    </item>
    <item android:left="2dp" android:top="2dp" android:right="1dp" android:bottom="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="11dp" />
            <solid android:color="@color/kz_widget_well" />
        </shape>
    </item>
</layer-list>
