<?xml version="1.0" encoding="utf-8"?>
<!-- The door of the prayer of the hour (CLAY › States › Selected): sunk into the material with a thin copper outline in
     its own shape — never a filled colour, never a glow. Same outer bounds as a raised door. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:right="1dp" android:bottom="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <gradient android:angle="315" android:startColor="@color/kz_widget_sink" android:endColor="@color/kz_widget_sink_hi" />
        </shape>
    </item>
    <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="3dp">
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <solid android:color="@color/kz_widget_sunk" />
        </shape>
    </item>
    <item android:right="1dp" android:bottom="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="@color/kz_widget_clear" />
            <stroke android:width="1dp" android:color="@color/kz_widget_outline" />
        </shape>
    </item>
</layer-list>
