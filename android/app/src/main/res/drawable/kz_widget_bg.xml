<?xml version="1.0" encoding="utf-8"?>
<!-- The widget's body — one clay card (CLAY › Layers): a bright rim toward the light (upper left), a shaded rim away
     from it, the card's two stops, and a faint pool of light at the top. A widget cannot cast a shadow onto the
     wallpaper, so its volume is all inside. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/kz_widget_radius" />
            <solid android:color="@color/kz_widget_rim_lo" />
        </shape>
    </item>
    <item android:right="1.5dp" android:bottom="1.5dp">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/kz_widget_radius" />
            <solid android:color="@color/kz_widget_rim_hi" />
        </shape>
    </item>
    <item android:left="1dp" android:top="1dp" android:right="1.5dp" android:bottom="1.5dp">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/kz_widget_radius" />
            <gradient android:angle="315" android:startColor="@color/kz_widget_top" android:endColor="@color/kz_widget_bottom" />
        </shape>
    </item>
    <item android:left="1dp" android:top="1dp" android:right="1.5dp" android:bottom="1.5dp">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/kz_widget_radius" />
            <gradient android:type="radial" android:centerX="0.12" android:centerY="0" android:gradientRadius="220dp"
                android:startColor="@color/kz_widget_halo" android:endColor="@color/kz_widget_halo_fade" />
        </shape>
    </item>
</layer-list>
