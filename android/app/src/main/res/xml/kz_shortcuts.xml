        <intent
            android:action="android.intent.action.VIEW"
            android:data="kzohaar://open/omer"
            android:targetClass="com.kzohaar.app.MainActivity"
            android:targetPackage="com.kzohaar.app" />
    </shortcut>
    <shortcut
        android:shortcutId="parasha"
        android:enabled="true"
        android:icon="@drawable/kz_shortcut_parasha"
        android:shortcutShortLabel="@string/kz_shortcut_parasha"
