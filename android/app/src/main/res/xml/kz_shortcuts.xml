        <intent
            android:action="android.intent.action.VIEW"
            android:data="kzohaar://open/parasha"
            android:targetClass="com.kzohaar.app.MainActivity"
            android:targetPackage="com.kzohaar.app" />
    </shortcut>
</shortcuts>
