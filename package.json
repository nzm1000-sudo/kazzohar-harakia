{
  "name": "luach-kazzohar-harakia",
  "version": "1.0.0",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:native": "VITE_NATIVE=true VITE_BUILD_ID=$(git rev-parse --short HEAD) VITE_BUILD_TIMESTAMP=$(date -u +%Y-%m-%dT%H:%M:%SZ) VITE_APP_VERSION=1.0.0 vite build",
    "cap:sync": "npm run build:native && npx cap sync",
    "cap:ios": "npm run cap:sync && npx cap open ios",
    "cap:android": "npm run cap:sync && npx cap open android",
    "preview": "vite preview",
    "test": "node --test tests/*.test.mjs",
    "test:live": "RUN_LIVE_SEFARIA_TESTS=1 node --test tests/halachaBooks.test.mjs",
    "coverage:vilna": "node scripts/verify-vilna-coverage.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.2",
    "@capacitor/geolocation": "^8.2.2",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/local-notifications": "^8.3.1",
    "@fontsource/frank-ruhl-libre": "^5.3.0",
    "@fontsource/heebo": "^5.3.0",
    "@fontsource/noto-sans-hebrew": "^5.3.0",
    "@fontsource/noto-serif-hebrew": "^5.3.0",
    "@hebcal/core": "^6.9.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@vitejs/plugin-react": "^4.0.0",
    "vite": "^4.4.0"
  }
}
